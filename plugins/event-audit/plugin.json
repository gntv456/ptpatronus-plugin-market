{
  "id": "event-audit",
  "name": "事件审计",
  "version": "1.0.0",
  "api_version": "1",
  "app_version": ">=0.1.0",
  "author": "PTPatronus Community",
  "description": "记录插件事件总线中的关键事件，便于排查 Webhook、测试事件和后续业务事件。",
  "license": "MIT",
  "keywords": [
    "event",
    "audit"
  ],
  "runtime": "external-http",
  "entry": {
    "command": "python",
    "args": [
      "plugin.py"
    ],
    "health": "/health"
  },
  "permissions": [
    "log:write"
  ],
  "events": [
    {
      "type": "plugin.test",
      "description": "测试事件"
    },
    {
      "type": "webhook",
      "description": "Webhook"
    }
  ],
  "actions": [
    {
      "name": "echo",
      "label": "回显输入",
      "description": "返回提交的 JSON。"
    },
    {
      "name": "emit_test_event",
      "label": "发出测试事件",
      "description": "发布 plugin.test。"
    }
  ],
  "config_schema": [
    {
      "key": "include_payload",
      "label": "记录事件数据",
      "type": "switch",
      "default": true
    }
  ]
}
