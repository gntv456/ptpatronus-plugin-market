{
  "id": "json-toolbox",
  "name": "JSON 工具箱",
  "version": "1.0.0",
  "api_version": "1",
  "app_version": ">=0.1.0",
  "author": "PTPatronus Community",
  "description": "格式化、压缩、取值路径与 JSON 校验工具。",
  "license": "MIT",
  "keywords": [
    "json"
  ],
  "runtime": "external-http",
  "entry": {
    "command": "python",
    "args": [
      "plugin.py"
    ],
    "health": "/health"
  },
  "permissions": [
    "log:write"
  ],
  "events": [],
  "actions": [
    {
      "name": "format",
      "label": "格式化",
      "description": "美化 JSON 文本。"
    },
    {
      "name": "minify",
      "label": "压缩",
      "description": "压缩 JSON 文本。"
    },
    {
      "name": "get",
      "label": "路径取值",
      "description": "按点路径取值，如 a.b.0.c。"
    },
    {
      "name": "validate",
      "label": "校验",
      "description": "检查是否为合法 JSON。"
    }
  ],
  "config_schema": [
    {
      "key": "indent",
      "label": "缩进空格",
      "type": "number",
      "default": 2
    }
  ]
}
