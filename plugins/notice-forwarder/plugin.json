{
  "id": "notice-forwarder",
  "name": "事件通知桥",
  "version": "1.0.0",
  "api_version": "1",
  "app_version": ">=0.1.0",
  "author": "PTPatronus Community",
  "description": "将指定事件转成站内通知，并复用系统通知通道外发。",
  "license": "MIT",
  "keywords": [
    "notice"
  ],
  "runtime": "external-http",
  "entry": {
    "command": "python",
    "args": [
      "plugin.py"
    ],
    "health": "/health"
  },
  "permissions": [
    "notice:write",
    "log:write"
  ],
  "events": [
    {
      "type": "plugin.test",
      "description": "测试事件"
    },
    {
      "type": "webhook",
      "description": "Webhook"
    }
  ],
  "actions": [
    {
      "name": "send_test_notice",
      "label": "发送测试通知",
      "description": "发送一条测试通知。"
    }
  ],
  "config_schema": [
    {
      "key": "event_types",
      "label": "监听事件",
      "type": "textarea",
      "default": "plugin.test"
    },
    {
      "key": "title_prefix",
      "label": "标题前缀",
      "type": "text",
      "default": "[插件]"
    },
    {
      "key": "level",
      "label": "通知级别",
      "type": "select",
      "default": "info",
      "options": [
        {
          "label": "信息",
          "value": "info"
        },
        {
          "label": "警告",
          "value": "warning"
        },
        {
          "label": "危险",
          "value": "danger"
        }
      ]
    },
    {
      "key": "include_payload",
      "label": "附带事件数据",
      "type": "switch",
      "default": false
    }
  ]
}
