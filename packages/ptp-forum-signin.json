{
  "id": "ptp-forum-signin",
  "name": "论坛签到",
  "version": "1.0.0",
  "api_version": "1",
  "runtime": "external-http",
  "archive": "archives/ptp-forum-signin-1.0.0.zip",
  "sha256": "1dbfa9040e9147c8df2e0a6ccc45a73bf5aa04d61201c5305ab84dbe0aa424e9",
  "app_version": ">=0.1.0",
  "host_capabilities": [
    "host.runtime.external-http.command",
    "host.schedule.cron",
    "host.api.log.write",
    "host.api.notice.write",
    "host.api.kv.read",
    "host.api.kv.write"
  ],
  "author": "PTPatronus Community",
  "description": "对已配置站点执行论坛签到（开源市场版，支持通用 URL 签到模板）。",
  "license": "MIT",
  "keywords": [
    "forum",
    "signin"
  ],
  "permissions": [
    "log:write",
    "notice:write",
    "kv:read",
    "kv:write"
  ],
  "actions": [
    {
      "name": "run",
      "label": "立即签到",
      "description": "执行全部站点签到。"
    },
    {
      "name": "labels",
      "label": "支持列表",
      "description": "返回内置站点标签。"
    }
  ],
  "config_schema": [
    {
      "key": "sites",
      "label": "签到站点",
      "type": "textarea",
      "default": "",
      "help": "每行 name|url|cookie 或 name|url"
    },
    {
      "key": "cron",
      "label": "定时",
      "type": "text",
      "default": "0 8 * * *"
    },
    {
      "key": "notify",
      "label": "通知",
      "type": "switch",
      "default": true
    }
  ],
  "resource_access": {
    "net_hosts": [
      "配置的论坛站点"
    ]
  },
  "signature": "tunXHcd3Kt7Qc1dIBIflRpIgoFFr4hHUxgx/HJ8Ey6++z8DI4Dw7zaEWTR4CLgO8PTA2aa/iIDi/HICDn5fLCA==",
  "publisher": {
    "id": "ptpatronus",
    "name": "PTPatronus Official",
    "website": "https://ptang.top",
    "verified": true
  },
  "changelog": [
    "migrated from PTPatronus built-in to open market"
  ]
}
