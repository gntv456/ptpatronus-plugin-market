{
  "id": "xiaomi-router",
  "name": "小米路由器监控",
  "version": "1.0.0",
  "api_version": "1",
  "runtime": "external-http",
  "archive": "archives/xiaomi-router-1.0.0.zip",
  "sha256": "0124acff3b97cafa9ff51a7cd4a43da3db6fe86cc05d142c2f110f5c288af981",
  "app_version": ">=0.1.0",
  "host_capabilities": [
    "host.runtime.external-http.command",
    "host.schedule.cron",
    "host.api.log.write",
    "host.api.notice.write"
  ],
  "author": "PTPatronus Community",
  "description": "登录小米路由器，查看状态并管理端口映射（开源市场版；完整增强见 ptp-miwifi）。",
  "license": "MIT",
  "keywords": [
    "xiaomi",
    "router"
  ],
  "permissions": [
    "log:write",
    "notice:write"
  ],
  "actions": [
    {
      "name": "status",
      "label": "刷新状态",
      "description": "登录并读取设备/系统状态。"
    },
    {
      "name": "port_list",
      "label": "端口映射列表",
      "description": "读取端口映射。"
    },
    {
      "name": "port_add",
      "label": "添加端口映射",
      "description": "name/proto/sport/ip/dport"
    },
    {
      "name": "port_delete",
      "label": "删除端口映射",
      "description": "按外部端口删除"
    },
    {
      "name": "quick_toggle",
      "label": "快捷切换",
      "description": "按预设增删映射"
    }
  ],
  "config_schema": [
    {
      "key": "router_url",
      "label": "路由器地址",
      "type": "text",
      "default": "http://192.168.31.1"
    },
    {
      "key": "password",
      "label": "登录密码",
      "type": "password",
      "default": ""
    },
    {
      "key": "timeout_seconds",
      "label": "超时",
      "type": "number",
      "default": 10
    },
    {
      "key": "quick_name",
      "label": "快捷规则名",
      "type": "text",
      "default": "ptp-quick"
    },
    {
      "key": "quick_proto",
      "label": "快捷协议",
      "type": "text",
      "default": "tcp"
    },
    {
      "key": "quick_sport",
      "label": "快捷外部端口",
      "type": "number",
      "default": 8000
    },
    {
      "key": "quick_ip",
      "label": "快捷内网IP",
      "type": "text",
      "default": ""
    },
    {
      "key": "quick_dport",
      "label": "快捷内部端口",
      "type": "number",
      "default": 8000
    },
    {
      "key": "cron_status",
      "label": "定时刷新",
      "type": "text",
      "default": ""
    }
  ],
  "resource_access": {
    "net_hosts": [
      "小米路由器管理地址"
    ]
  },
  "signature": "XLKROI4I0eECnsHGD19AjfNZ7bOnQjTQgYR+1hfQUvgLN/zZA2rGjomAKIgXQIx7FDCPUEPjavPWUEuxBP43BA==",
  "publisher": {
    "id": "ptpatronus",
    "name": "PTPatronus Official",
    "website": "https://ptang.top",
    "verified": true
  },
  "changelog": [
    "migrated from PTPatronus built-in to open market"
  ]
}
