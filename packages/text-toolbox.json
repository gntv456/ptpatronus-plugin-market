      "label": "变换",
      "description": "upper/lower/title/strip。"
    },
    {
      "name": "replace",
      "label": "替换",
      "description": "查找替换。"
    },
    {
      "name": "split_unique",
      "label": "分割去重",
      "description": "按分隔符分割并去重。"
    },
    {
      "name": "hash",
      "label": "哈希",
      "description": "md5/sha1/sha256。"
    }
  ],
  "signature": "dfSVNMtgefat/kWrYnzqgvmaEDfuBxtF+ZzUwV2RZKVjgqyQMJDr1f1hg4bfjz0XZ6romP1kqexv/s1p5ZXtAA==",
