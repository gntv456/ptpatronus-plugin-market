    },
    {
      "name": "device_authority",
      "label": "\u8bbe\u5907\u4e0a\u7f51\u6743\u9650",
      "description": "input.mac + wan/lan/admin\uff1bkick=true \u7b49\u4ef7 wan=0\u3002"
    },
    {
      "name": "port_forward",
      "label": "\u7aef\u53e3\u6620\u5c04",
      "description": "\u7aef\u53e3\u6620\u5c04\uff08\u8f6c\u53d1\uff09\u3002op=list|add|delete|enable|disable\u3002add \u9700 ip + sport(\u5916\u90e8\u7aef\u53e3)\uff0c\u53ef\u9009 dport/protocol/name/enable\uff1b\u4e5f\u53ef\u7528 external_port/internal_port/dest_ip \u522b\u540d\u3002delete \u9700 fwid \u6216 name \u6216 ip+sport\u3002"
    },
    {
      "name": "time_info",
